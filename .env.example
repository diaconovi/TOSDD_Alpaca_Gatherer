# Copy to .env and fill in. Every variable is read at startup; an invalid value stops the service.

# Collector service (Capital.com data), as a full URL with host and port.
COLLECTOR_URL=http://localhost:8001

# MongoDB connection, without the port (the port is MONGO_PORT).
MONGO_URL=mongodb://localhost
# MongoDB port, 1-65535.
MONGO_PORT=27017
# Database holding every collection of this service. Required.
MONGO_MAPPING_DB=
# Live mapping collection; runs, schedule and credentials use <name>_runs, <name>_schedule,
# <name>_credentials. Required; must not contain "$" or ".".
MONGO_MAPPING_COLLECTION=

# Log level: INFO | DEBUG | WARNING.
LOGGING=INFO
# IANA timezone for log timestamps and other non-schedule output (schedules use their own zone).
TIME_ZONE=America/Mexico_City

# Fernet key that encrypts the Alpaca credentials. Required. Generate one with:
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# YAML file with the matching thresholds.
THRESHOLDS_FILE=config/thresholds.yaml
# Executed runs kept in history (minimum 50).
RUN_HISTORY_LIMIT=50

# Alpaca REST endpoints.
ALPACA_TRADING_URL=https://paper-api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets
